name = "moonbit-community/postgres"

version = "0.1.2"

import {
  "moonbitlang/x@0.5.6",
  "moonbitlang/async@0.22.5",
  "moonbit-community/unicode-normalization@0.6.0",
}

readme = "README.md"

repository = "https://github.com/moonbit-community/postgres.mbt"

license = "Apache-2.0"

keywords = [ ]

description = "A secure, easy-to-use PostgreSQL client library for MoonBit with an included connection pool."

preferred_target = "wasm"
